---
const items = [
  {
    text: "Locally operated in Thunder Bay",
    // map pin
    path: "M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z",
  },
  {
    text: "Licensed & insured contractor",
    // shield check
    path: "M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3zm-1.2 13.5-3.2-3.2 1.4-1.4 1.8 1.8 4.2-4.2 1.4 1.4-5.6 5.6z",
  },
  {
    text: "Your photo is never shared or posted",
    // lock
    path: "M17 9V7a5 5 0 0 0-10 0v2H5v13h14V9h-2zm-8-2a3 3 0 0 1 6 0v2H9V7zm4 9.7V19h-2v-2.3a2 2 0 1 1 2 0z",
  },
];
---

<section class="trust">
  <div class="container">
    <ul class="trust__list">
      {
        items.map(({ text, path }) => (
          <li class="trust__item">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={path} />
            </svg>
            {text}
          </li>
        ))
      }
    </ul>
  </div>
</section>
