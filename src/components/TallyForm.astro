---
import { SITE } from "../config";
---

<section class="section section--alt form-section" id="form">
  <div class="container">
    <h2>Get My Free Design</h2>
    <p>
      Fill this out and we'll text you to grab one photo of your bathroom —
      your free design and a real local quote are on the way.
    </p>
    <a class="btn" href="#form">Get My Free Design</a>

    <!--
      Tally form fields (configured in the Tally dashboard for {{FORM_ENDPOINT}}):
        - Name
        - Phone
        - What are you looking to do? (Tub-to-shower conversion / Full renovation / Accessible bathroom / Not sure yet)
        - When? (ASAP / 1–3 months / Just exploring)
      Tally's "On submit" redirect is set to /thank-you in the Tally dashboard.
    -->
    <div class="tally-embed">
      <iframe
        data-tally-src={`${SITE.formEndpoint}?transparentBackground=1&dynamicHeight=1`}
        loading="lazy"
        width="100%"
        height="400"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        title="Get My Free Design"
      ></iframe>
    </div>
  </div>
</section>

<script is:inline>
  var d = document,
    w = "https://tally.so/widgets/embed.js",
    v = function () {
      typeof Tally !== "undefined"
        ? Tally.loadEmbeds()
        : d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach(function (e) {
            e.src = e.dataset.tallySrc;
          });
    };
  if (typeof Tally !== "undefined") {
    v();
  } else if (d.querySelector('script[src="' + w + '"]') == null) {
    var s = d.createElement("script");
    s.src = w;
    s.async = true;
    s.onload = v;
    s.onerror = v;
    d.body.appendChild(s);
  }
</script>
