---
interface Props {
  beforeSrc: string;
  afterSrc: string;
  alt: string;
  eager?: boolean;
}

const { beforeSrc, afterSrc, alt, eager = false } = Astro.props;
---

<div class="ba-slider">
  <figure class="ba-slider__figure">
    <img
      class="ba-slider__img ba-slider__img--before"
      src={beforeSrc}
      alt={`${alt} — before`}
      width="960"
      height="720"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
    <img
      class="ba-slider__img ba-slider__img--after"
      src={afterSrc}
      alt={`${alt} — after`}
      width="960"
      height="720"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
    <span class="ba-slider__label ba-slider__label--before">Before</span>
    <span class="ba-slider__label ba-slider__label--after">After</span>
    <span class="ba-slider__divider"></span>
    <span class="ba-slider__handle" aria-hidden="true">
      <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8.6 7.4 4 12l4.6 4.6L10 15.2 6.8 12 10 8.8 8.6 7.4zm6.8 0L14 8.8l3.2 3.2-3.2 3.2 1.4 1.4L20 12l-4.6-4.6z" />
      </svg>
    </span>
    <input
      class="ba-slider__range"
      type="range"
      min="0"
      max="100"
      value="50"
      aria-label="Drag to compare before and after"
    />
  </figure>
</div>

<script is:inline>
  // is:inline keeps this in the page HTML itself — no separate script request.
  document.querySelectorAll(".ba-slider").forEach((slider) => {
    const range = slider.querySelector(".ba-slider__range");
    if (!(range instanceof HTMLInputElement)) return;
    range.addEventListener("input", () => {
      slider.setAttribute("style", `--ba-pos: ${range.value}%`);
    });
  });
</script>
