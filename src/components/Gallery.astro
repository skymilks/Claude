---
const pairs = [
  { before: "/images/demo2_before.jpg", after: "/images/demo2_after.jpg" },
  { before: "/images/demo3_before.jpg", after: "/images/demo3_after.jpg" },
];
---

<section class="section section--alt" id="gallery">
  <div class="container">
    <h2>More real transformations</h2>
    <div class="gallery">
      {
        pairs.map(({ before, after }) => (
          <div class="gallery__pair">
            <div class="gallery__half">
              <img
                class="gallery__img"
                src={before}
                alt="Bathroom before renovation"
                width="720"
                height="960"
                loading="lazy"
                decoding="async"
              />
              <span class="gallery__chip">Before</span>
            </div>
            <div class="gallery__half">
              <img
                class="gallery__img"
                src={after}
                alt="Bathroom after renovation"
                width="720"
                height="960"
                loading="lazy"
                decoding="async"
              />
              <span class="gallery__chip gallery__chip--after">After</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
