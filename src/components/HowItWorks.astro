---
// Copy is used verbatim; each step is split at its em dash purely for styling.
const steps = [
  ["Snap a photo of your bathroom", "30 seconds, any phone"],
  ["We design your renovation", "see YOUR bathroom transformed, free"],
  ["Get a real quote", "one licensed local contractor, no spam, no bidding wars"],
];
---

<section class="section" id="how-it-works">
  <div class="container">
    <h2>How it works</h2>
    <ol class="steps">
      {
        steps.map(([lead, rest], i) => (
          <li class="step">
            <span class="step__num">{String(i + 1).padStart(2, "0")}</span>
            <p>
              <span class="step__lead">{lead}</span>
              <span class="step__rest"> — {rest}</span>
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
